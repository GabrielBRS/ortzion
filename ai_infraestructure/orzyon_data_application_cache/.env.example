# Configuração de exemplo do orzyon_data_application_cache.
# A aplicação NÃO carrega .env automaticamente (sem dotenv): exporte as
# variáveis no seu shell (`export $(grep -v '^#' .env | xargs)`) ou
# configure via ambiente do processo/orquestrador.

# Endereço/porta do servidor gRPC. Loopback apenas por padrão —
# não exponha publicamente (esta versão não tem autenticação).
ORZYON_CACHE_GRPC_ADDR=127.0.0.1:50051

# TTL padrão aplicado a entradas sem TTL próprio (segundos).
ORZYON_CACHE_DEFAULT_TTL_SECS=300

# Capacidade alvo global em QUANTIDADE DE ENTRADAS.
# Não é um limite rígido de memória RAM — ao exceder, o Moka evita
# entradas por frequência/recência (TinyLFU).
ORZYON_CACHE_MAX_CAPACITY=100000

# Tamanho máximo de um único valor, em bytes.
ORZYON_CACHE_MAX_ENTRY_BYTES=1048576

# Tamanho máximo de uma mensagem gRPC recebida, em bytes.
# Deve ser maior que ORZYON_CACHE_MAX_ENTRY_BYTES (valor + metadados).
ORZYON_CACHE_GRPC_MAX_DECODING_BYTES=4194304

# Nível de log (sintaxe tracing-subscriber EnvFilter).
ORZYON_LOG_LEVEL=info
